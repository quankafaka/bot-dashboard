# Copy to .env.local for local dev. On Vercel, add the same two names under
# Project -> Settings -> Environment Variables.
# Supabase -> Project Settings -> API. Use the anon / publishable key,
# NEVER the service_role / secret key: this one ships to the browser.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only on the public steam-chasing-dashboard Vercel project: no login, CAD
# books only (run supabase/016_public_cad.sql first). Unset on the real one.
# VITE_PUBLIC=1
